{
  "name": "tidyproteomics-agent",
  "version": "1.0.0",
  "description": "Standalone Modern Web Studio for TidyProteomics Autonomous Agent & MCP Pipeline",
  "private": true,
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "rescore": "tsx src/evaluation/rescore.ts",
    "test:rubric": "tsx src/evaluation/__tests__/rubric.test.ts",
    "stop": "lsof -ti tcp:3000 | xargs kill -9 2>/dev/null || true",
    "prestart": "lsof -ti tcp:3000 | xargs kill -9 2>/dev/null || true",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "lucide-react": "^0.454.0",
    "marked": "^14.1.3",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
